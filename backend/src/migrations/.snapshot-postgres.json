  "views": [
    {
      "name": "query_stats",
      "schema": "ppg",
      "definition": "SELECT prisma_model,\n    prisma_action,\n    prisma_payload,\n    query_id,\n    query_sample,\n    calls,\n    total_exec_time_ms,\n    min_exec_time_ms,\n    max_exec_time_ms,\n    (total_exec_time_ms / (NULLIF(calls, 0))::double precision) AS mean_exec_time_ms,\n    rows,\n    shared_blks_hit,\n    shared_blks_read,\n    shared_blks_dirtied,\n    shared_blks_written,\n    local_blks_hit,\n    local_blks_read,\n    local_blks_dirtied,\n    local_blks_written,\n    temp_blks_read,\n    temp_blks_written,\n    shared_blk_read_time,\n    shared_blk_write_time,\n    local_blk_read_time,\n    local_blk_write_time,\n    temp_blk_read_time,\n    temp_blk_write_time,\n    wal_records,\n    wal_fpi,\n    wal_bytes,\n    (to_timestamp((((first_seen_us)::numeric / 1000000.0))::double precision) + '30 years'::interval) AS first_seen,\n    (to_timestamp((((last_seen_us)::numeric / 1000000.0))::double precision) + '30 years'::interval) AS last_seen\n   FROM ppg._query_stats_internal() _query_stats_internal(dbid, prisma_model, prisma_action, prisma_payload, query_id, query_sample, calls, total_exec_time_ms, min_exec_time_ms, max_exec_time_ms, rows, shared_blks_hit, shared_blks_read, shared_blks_dirtied, shared_blks_written, local_blks_hit, local_blks_read, local_blks_dirtied, local_blks_written, temp_blks_read, temp_blks_written, shared_blk_read_time, shared_blk_write_time, local_blk_read_time, local_blk_write_time, temp_blk_read_time, temp_blk_write_time, wal_records, wal_fpi, wal_bytes, first_seen_us, last_seen_us)\n  WHERE (dbid = ( SELECT pg_database.oid\n           FROM pg_database\n          WHERE (pg_database.datname = current_database())))"
    }
  ],
